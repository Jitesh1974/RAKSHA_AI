ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Application database
POSTGRES_USER=raksha
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=raksha
DATABASE_URL=postgresql://raksha:CHANGE_ME@postgres:5432/raksha
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT device authentication
# Generate a strong secret locally; never commit or share the real value.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=raksha-ai
JWT_AUDIENCE=raksha-ai-api
# Defaults to DEVICE_TOKEN_TTL_DAYS * 24 * 60 when omitted.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=259200

# Device bootstrap is intentionally lightweight in this release. Add Play Integrity/device
# attestation, per-device rate limiting, quotas and account lifecycle controls before public launch.

# Internal LLM service
LLAMA_CPP_BASE_URL=http://llm:8080/v1
LLAMA_CPP_MODEL=raksha-qwen
LLAMA_CPP_TIMEOUT_SECONDS=60
LLAMA_CPP_MAX_TOKENS=256
LLAMA_CPP_TEMPERATURE=0.1
LLAMA_CPP_RETRY_COUNT=1

LLM_PROVIDER_MESSAGE_AGENT=llama_cpp
LLM_PROVIDER_EXPLANATION_AGENT=llama_cpp
LLM_FALLBACK_PROVIDER=

# External intelligence integrations
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Gemini fallback
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODELS_MESSAGE_AGENT=
GEMINI_MODELS_EXPLANATION_AGENT=
GEMINI_MODEL_RPM=
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_COUNT=0
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_MODEL_COOLDOWN_SECONDS=60
GEMINI_DAILY_QUOTA_COOLDOWN_SECONDS=21600

MAX_CONCURRENT_ANALYSES=5
MAX_ANALYSIS_QUEUE_WAIT_SECONDS=180
MAX_CONCURRENT_LLM_REQUESTS=2
MAX_LLM_REQUESTS_PER_MINUTE=10

# Graph database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_AUTH=neo4j/CHANGE_ME

# Legacy Google/Gmail integrations are disabled by default.
ENABLE_LEGACY_GOOGLE_AUTH=false
ENABLE_LEGACY_EMAIL_SYNC=false
# Google OAuth — only used when the legacy integration is explicitly enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# Public HTTPS origin
PUBLIC_API_ORIGIN=https://api.example.com
